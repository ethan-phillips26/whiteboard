  <diagram id="ucs-page-2" name="Use Case Specification (UC-03)">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="Use Case Specification — UC-03: Turn Off HVAC After 10 Minutes of Vacancy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="40" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="Use Case ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="UC-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="Use Case Name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Turn Off HVAC After 10 Minutes of Vacancy (place an unoccupied room into energy-setback mode)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l3" value="Brief Description" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="The Building HVAC Control System detects that a room has been continuously unoccupied for ten minutes, confirms that no scheduled use of the room is imminent, and commands the room's HVAC zone into setback mode. The energy baseline for the setback period is logged so the savings can later be reported to the Vice President." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="760" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l4" value="Primary Actor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Occupancy Sensor (the system is time-triggered on the sensor polling cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="210" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l5" value="Secondary Actors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="HVAC Zone Controller, Company Calendar System, Maintenance Technician (on fault), Facilities Manager (dashboard observer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="240" width="760" height="50" as="geometry" />
        </mxCell>

        <mxCell id="l6" value="Stakeholders and Interests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="&#8226; Vice President for Bigger Profits — wants measurable, auditable reduction in energy spend.&#10;&#8226; Building Occupants — want rooms comfortable whenever they are actually in use.&#10;&#8226; Facilities Manager — wants equipment protected and faults surfaced quickly.&#10;&#8226; Humongous Corporation — wants lower utility cost across all six buildings without complaints." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="290" width="760" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l7" value="Preconditions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="&#8226; The Building HVAC Control System is running and holds the room registry for its building.&#10;&#8226; The room has a commissioned occupancy sensor whose last health check passed.&#10;&#8226; The room's HVAC zone is reachable and currently in occupied (normal) mode.&#10;&#8226; No manual temperature override (UC-07) is active for the room." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="760" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l8" value="Trigger" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="The occupancy sensor for a room reports &quot;no occupant detected&quot; on a polling cycle, starting the room's vacancy timer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="470" width="760" height="40" as="geometry" />
        </mxCell>

        <mxCell id="l9" value="Main Success Scenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="220" height="260" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="1. The system polls the occupancy sensor for each room in its building on the scheduled cycle (default: every 30 seconds).&#10;2. The sensor for Room R reports no occupant detected.&#10;3. The system confirms the reading is fresh and in range and that the sensor is flagged operational. [include: Verify Sensor Operational Status]&#10;4. The system starts (or continues) the vacancy timer for Room R.&#10;5. The vacancy timer reaches 10 minutes with no occupancy detected in any intervening poll.&#10;6. The system queries the calendar service for any scheduled use of Room R beginning within the next 10 minutes. [include: Retrieve Room Schedule]&#10;7. The calendar service returns no upcoming booking inside that window.&#10;8. The system computes the setback setpoints for Room R from the active seasonal profile. [include: Apply Seasonal Temperature Profile]&#10;9. The system commands the HVAC zone controller for Room R to enter setback mode at those setpoints.&#10;10. The HVAC zone controller acknowledges and reports the new mode.&#10;11. The system writes a setback record (room ID, timestamp, outside air temperature, prior and new setpoints) to the energy log for later savings calculation.&#10;12. The system updates Room R on the dashboard to &quot;Unoccupied — HVAC Setback&quot; and the use case ends." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="510" width="760" height="260" as="geometry" />
        </mxCell>

        <mxCell id="l10" value="Alternate Flows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="5a. Occupancy is detected before the timer reaches 10 minutes.&#10;&#160;&#160;&#160;&#160;5a1. The system clears the vacancy timer and leaves the zone in occupied mode. The use case ends.&#10;7a. A booking for Room R starts within the next 10 minutes.&#10;&#160;&#160;&#160;&#160;7a1. The system suppresses the setback, logs the suppression reason, and invokes Pre-Condition Room for Scheduled Event (UC-05). The use case ends.&#10;7b. A manual override (UC-07) became active while the timer was running.&#10;&#160;&#160;&#160;&#160;7b1. The system honors the override setpoints, logs that setback was skipped, and ends.&#10;10a. The HVAC zone controller does not acknowledge within 30 seconds.&#10;&#160;&#160;&#160;&#160;10a1. The system retries the command up to three times at 30-second intervals.&#10;&#160;&#160;&#160;&#160;10a2. On a successful retry, the flow resumes at step 11." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="770" width="760" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l11" value="Exception Flows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="E1 (step 3). The sensor fails its health check or returns a stale/out-of-range reading.&#10;&#160;&#160;&#160;&#160;The system marks the sensor as failed, treats the room as occupied (fail-safe), notifies the Maintenance Technician, and aborts the setback.&#10;E2 (step 6). The calendar service is unreachable.&#10;&#160;&#160;&#160;&#160;The system uses the most recent cached schedule; if no cache younger than 24 hours exists, it suppresses the setback and raises a degraded-mode warning on the dashboard.&#10;E3 (step 10). The HVAC zone controller is unreachable after all retries.&#10;&#160;&#160;&#160;&#160;The system records an HVAC communication fault, flags the room on the dashboard, and notifies the Maintenance Technician. The room state is left unchanged.&#10;E4 (any step). The building controller itself fails.&#10;&#160;&#160;&#160;&#160;A peer building controller detects the failure and takes over this use case for the building (UC-13 / UC-14)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="950" width="760" height="160" as="geometry" />
        </mxCell>

        <mxCell id="l12" value="Postconditions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="Success: Room R's HVAC zone is in setback mode at the seasonal setback setpoints; a setback record exists in the energy log; the dashboard reflects the new state.&#10;Failure: Room R's HVAC zone remains in its previous mode; a fault record exists; the responsible party has been notified; no false savings are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1110" width="760" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l13" value="Business Rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="BR-1. Vacancy threshold is 10 continuous minutes (configurable 5–30 minutes per room type).&#10;BR-2. A returning occupant must be present 2 continuous minutes before HVAC is restored (UC-04).&#10;BR-3. Rooms are pre-conditioned beginning 10 minutes before a scheduled start (UC-05).&#10;BR-4. Setback setpoints follow the active seasonal profile (e.g., heating setback 62°F / cooling setback 82°F versus occupied 70°F / 74°F).&#10;BR-5. Equipment-protection limits override all setback logic; a zone is never allowed to drift below 55°F.&#10;BR-6. A manual override takes priority over automatic setback and expires after 2 hours unless renewed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1200" width="760" height="130" as="geometry" />
        </mxCell>

        <mxCell id="l14" value="Special Requirements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="&#8226; Sensor polling interval no greater than 30 seconds per room.&#10;&#8226; HVAC command issued within 5 seconds of the vacancy threshold being met.&#10;&#8226; Energy log entries retained 24 months to support monthly and annual savings reporting.&#10;&#8226; Controller availability of at least 99.5%, with peer failover completing within 60 seconds.&#10;&#8226; Every mode change is auditable: who or what caused it, when, and the setpoints before and after." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1330" width="760" height="110" as="geometry" />
        </mxCell>

        <mxCell id="l15" value="Frequency of Use" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="Evaluated continuously for every room in the building. Expected to produce roughly 50–150 setback events per building per day, concentrated outside core business hours." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1440" width="760" height="50" as="geometry" />
        </mxCell>

        <mxCell id="l16" value="Assumptions and Open Issues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1490" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="&#8226; Assumes one occupancy sensor per room and one addressable HVAC zone per room; multi-zone rooms are out of scope for this release.&#10;&#8226; Assumes the calendar system exposes room bookings through a read-only interface.&#10;&#8226; Open: handling of rooms that a sensor cannot fully cover (large exhibition halls may need multiple sensors aggregated)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1490" width="760" height="80" as="geometry" />
        </mxCell>

        <mxCell id="l17" value="Traceability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontStyle=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1570" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="Satisfies: &quot;System shall turn off HVAC after 10 minutes of room non-occupancy&quot;; &quot;System shall interface with monitor sensors to ensure operational status&quot;; &quot;System shall adjust temperature settings based on season&quot;.&#10;Supports: cost savings reports, manual overrides, dashboard status, and single-building redundancy.&#10;Related use cases: UC-01, UC-02, UC-04, UC-05, UC-06, UC-07, UC-08, UC-10, UC-13, UC-14, UC-16." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="1570" width="760" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
