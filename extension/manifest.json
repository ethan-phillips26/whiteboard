{
  "manifest_version": 3,
  "name": "Whiteboard Connector",
  "version": "0.1.0",
  "description": "Lets the Whiteboard dashboard read your Blackboard courses with the session you already have. Read-only.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "webRequest"],
  "optional_host_permissions": [
    "https://*/*",
    "https://*.content.blackboardcdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["origin.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whiteboard-connector@ethanphillips.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": { "default_title": "Whiteboard Connector" },
  "content_scripts": [
    {
      "matches": ["https://ethanphillips.dev/whiteboard/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
